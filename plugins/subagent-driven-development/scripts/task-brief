#!/usr/bin/env bash
# Extract one task's full text from a plan into a file the implementer reads in
# one call, so the task text never passes through the controller's context.
# Usage: task-brief [-C WORKDIR] PLAN_FILE TASK_NUMBER [OUTFILE]
# -C pins the .sdd workspace to WORKDIR's tree regardless of the caller's cwd.
set -euo pipefail
workdir=""
if [ "${1:-}" = "-C" ]; then
  [ $# -ge 2 ] || { echo "usage: task-brief [-C WORKDIR] PLAN_FILE TASK_NUMBER [OUTFILE]" >&2; exit 2; }
  workdir=$2; shift 2
fi
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief [-C WORKDIR] PLAN_FILE TASK_NUMBER [OUTFILE]" >&2; exit 2
fi
plan=$1; n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
if [ $# -eq 3 ]; then out=$3
else dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" ${workdir:+"$workdir"}); out="$dir/task-${n}-brief.md"; fi
# Task ids are compared as whole tokens, not as a regex prefix: `Task 9` must not
# match `### Task 9A`, and `Task N3` must be findable at all. A heading ends the
# current task when it names any other task, or when it sits at the same level or
# shallower than the task's own heading — so a retirement note or the next section
# of an ADR is a boundary, instead of being silently appended to the brief.
awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]/ {
    match($0, /^#+/); depth = RLENGTH
    head = $0
    istask = sub(/^#+[ \t]+Task[ \t]+/, "", head)
    if (!istask) { plural = $0; istask = sub(/^#+[ \t]+Tasks[ \t]+/, "", plural) }
    id = (istask && match(head, /^[A-Za-z0-9]+/)) ? substr(head, 1, RLENGTH) : ""
    if (id != "" && id == n) { intask = 1; taskdepth = depth }
    else if (intask && (istask || depth <= taskdepth)) { intask = 0 }
  }
  intask { print }
' "$plan" > "$out"
if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2; exit 3
fi
echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
