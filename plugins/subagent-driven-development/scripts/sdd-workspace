#!/usr/bin/env bash
# Resolve/ensure the working-tree dir for SDD short-lived artifacts: task
# briefs, implementer reports, review packages. Lives in the
# working tree (not .git/, which Claude Code protects from agent writes). A
# self-ignoring .gitignore keeps it out of git status and commits.
# Usage: sdd-workspace [WORKDIR]
# WORKDIR pins the target tree explicitly; without it the workspace resolves
# from the caller's cwd, which lands in the wrong repo when an agent runs this
# before cd'ing into its worktree — always pass it in generated commands.
set -euo pipefail
if [ $# -ge 1 ]; then
  root=$(git -C "$1" rev-parse --show-toplevel)
else
  root=$(git rev-parse --show-toplevel)
fi
dir="$root/.sdd"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
