<?xml version="1.0" encoding="UTF-8"?>
<!-- Nightshift at 02:00. Install with the sed line in docs/developing/landing.md,
     which fills __REPO__ and __PATH__. caffeinate -i keeps the Mac awake while
     the loop runs; it goes back to sleep when the loop exits. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.nightshift.__NAME__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__REPO__/loop/land.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/nightshift/__NAME__/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/nightshift/__NAME__/launchd.log</string>
</dict>
</plist>
