        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ccguard\" json-config-guard",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
