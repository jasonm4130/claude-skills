node_modules/
__pycache__/
*.pyc
.env
.env.*
!.env.op
*.log
# ...except the Nightwatch morning's fixture: the logs ARE the test data (the
# pull request body is built from the log files, not from any summary of them).
!plugins/nightshift/tests/fixtures/**/*.log
.DS_Store
tmp/
.worktrees/
# Cargo build output. This machine redirects it via a global cargo config, so
# rust/target/ never appears here — but it will on a default toolchain, and the
# one thing that must NEVER be ignored is plugins/*/bin/ccguard, which is a build
# artifact that is deliberately committed (see rust/README.md).
rust/target/
/.claude/handoffs/
# claude plugin eval output; the cases are committed, the runs are not.
plugins/*/evals/results/
